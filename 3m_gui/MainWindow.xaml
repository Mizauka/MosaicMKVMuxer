<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MosaicMKVMuxer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MosaicMKVMuxer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Title="3mtool — Mosaic MKV Muxer">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════════════════ 自定义标题栏 ════════════════ -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="🎬" FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Text="  3mtool" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                <TextBlock Text=" — Mosaic MKV Muxer" FontSize="11" VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,12,0"/>
                <TextBlock x:Name="TitleBarStatus" Text="●" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"
                           Foreground="Gray" ToolTipService.ToolTip="后端状态"/>
            </StackPanel>

            <Border Grid.Column="1" x:Name="TitleBarDragRegion" Background="Transparent"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                <Button x:Name="BtnMinimize" Content="&#xE921;" Width="46" Height="32"
                        FontFamily="Segoe MDL2 Assets" FontSize="10"
                        Style="{StaticResource WindowControlButtonStyle}" Click="OnMinimizeClick"/>
                <Button x:Name="BtnMaximize" Content="&#xE922;" Width="46" Height="32"
                        FontFamily="Segoe MDL2 Assets" FontSize="10"
                        Style="{StaticResource WindowControlButtonStyle}" Click="OnMaximizeRestoreClick"/>
                <Button x:Name="BtnClose" Content="&#xE8BB;" Width="46" Height="32"
                        FontFamily="Segoe MDL2 Assets" FontSize="10"
                        Style="{StaticResource WindowControlCloseButtonStyle}" Click="OnCloseClick"/>
            </StackPanel>
        </Grid>

        <!-- ════════════════ NavigationView 侧栏 ════════════════ -->
        <controls:NavigationView x:Name="NavView" Grid.Row="1"
                                  PaneDisplayMode="LeftCompact"
                                  IsBackButtonVisible="Collapsed"
                                  IsSettingsVisible="False"
                                  IsPaneToggleButtonVisible="True"
                                  CompactPaneLength="48" OpenPaneLength="180"
                                  SelectionChanged="OnNavSelectionChanged">
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem x:Name="NavTools" Content="工具" Tag="tools">
                    <controls:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting"/>
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem x:Name="NavLogs" Content="日志" Tag="logs">
                    <controls:NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Document"/>
                    </controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
            </controls:NavigationView.MenuItems>

            <!-- 页面容器 -->
            <Grid>
            <!-- ── 工具页面 ── -->
            <ScrollViewer x:Name="ToolsPage" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,16,24,24" Spacing="16">

                    <controls:Expander Header="🔧 工具路径设置" IsExpanded="True"
                                       Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="6">
                        <StackPanel Margin="16,8,16,16" Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="FFmpeg:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox x:Name="FFmpegPathBox" Grid.Column="1" PlaceholderText="FFmpeg 可执行文件路径..." Margin="8,0,8,0"/>
                                <Button x:Name="BtnBrowseFFmpeg" Grid.Column="2" Content="📂" MinWidth="40" Click="OnBrowseFFmpeg"/>
                                <Button x:Name="BtnDetectFFmpeg" Grid.Column="3" Content="🔍 自动检测" Margin="4,0,0,0" Click="OnDetectFFmpeg"/>
                            </Grid>
                            <TextBlock x:Name="FFmpegStatus" Margin="8,0,0,0" FontSize="11"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="7-Zip:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox x:Name="SevenZipPathBox" Grid.Column="1" PlaceholderText="7-Zip 路径..." Margin="8,0,8,0"/>
                                <Button x:Name="BtnBrowse7z" Grid.Column="2" Content="📂" MinWidth="40" Click="OnBrowse7z"/>
                                <Button x:Name="BtnDetect7z" Grid.Column="3" Content="🔍 自动检测" Margin="4,0,0,0" Click="OnDetect7z"/>
                            </Grid>
                            <TextBlock x:Name="SevenZipStatus" Margin="8,0,0,0" FontSize="11"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>
                    </controls:Expander>

                    <controls:Expander Header="📁 工作区" IsExpanded="True"
                                       Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="6">
                        <StackPanel Margin="16,8,16,16" Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="输入目录:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox x:Name="InputDirBox" Grid.Column="1" PlaceholderText="包含 MP4、M4A 的文件夹..." Margin="8,0,8,0"/>
                                <Button x:Name="BtnBrowseInput" Grid.Column="2" Content="📂 浏览" Click="OnBrowseInput"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="输出目录:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox x:Name="OutputDirBox" Grid.Column="1" PlaceholderText="MKV 输出目录..." Margin="8,0,8,0"/>
                                <Button x:Name="BtnBrowseOutput" Grid.Column="2" Content="📂 浏览" Click="OnBrowseOutput"/>
                                <Button x:Name="BtnAutoOutput" Grid.Column="3" Content="🪄 自动" Margin="4,0,0,0" Click="OnAutoOutput"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text=" " VerticalAlignment="Center"/>
                                <Button x:Name="BtnScan" Grid.Column="1" Content="🔍 扫描工作区"
                                        Style="{StaticResource AccentButtonStyle}" MinWidth="130" MinHeight="36" Click="OnScanWorkspace"/>
                                <TextBlock x:Name="ScanStatus" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            </Grid>
                        </StackPanel>
                    </controls:Expander>

                    <controls:Expander Header="🎬 剧集列表" IsExpanded="True"
                                       Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="6">
                        <Grid Margin="0,8,0,8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="250"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,0,16,8" Spacing="8">
                                <Button x:Name="BtnSelectAll" Content="全选" FontSize="12" Click="OnSelectAll"/>
                                <Button x:Name="BtnDeselectAll" Content="取消全选" FontSize="12" Click="OnDeselectAll"/>
                                <TextBlock x:Name="EpisodeCount" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" Margin="16,0,16,8" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="EpisodePanel"/>
                            </ScrollViewer>
                        </Grid>
                    </controls:Expander>

                    <Grid Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="6" Padding="20">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="BtnStart" Content="🚀 开始合并"
                                        Style="{StaticResource AccentButtonStyle}"
                                        MinWidth="140" MinHeight="40" FontSize="14" FontWeight="SemiBold"
                                        IsEnabled="False" Click="OnStartMux"/>
                                <Button x:Name="BtnCancel" Content="⏹ 取消"
                                        MinWidth="100" MinHeight="40" IsEnabled="False" Click="OnCancelMux"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ProgressBar x:Name="MuxProgress" Grid.Column="0" Minimum="0" Maximum="100" Value="0" Height="6" CornerRadius="3"/>
                                <TextBlock x:Name="ProgressPercent" Grid.Column="1" Text="0%" Margin="12,0,0,0"
                                           VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                            </Grid>
                            <TextBlock x:Name="StatusText" Text="就绪" FontSize="12"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ── 日志页面 ── -->
            <Grid x:Name="LogsPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="24,16,24,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="📄 程序日志" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnRefreshLog" Content="🔄 刷新" Click="OnRefreshLog"/>
                        <Button x:Name="BtnExportLog" Content="📤 导出" Click="OnExportLog"/>
                        <Button x:Name="BtnOpenLogDir" Content="📂 打开目录" Click="OnOpenLogDir"/>
                        <Button x:Name="BtnClearLog" Content="🗑 清空" Click="OnClearLog"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" Margin="24,0,24,24" VerticalScrollBarVisibility="Auto"
                              Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="6">
                    <TextBlock x:Name="LogContent" Margin="16" FontSize="11"
                               FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               Text="暂无日志..."/>
                </ScrollViewer>
            </Grid>
            </Grid> <!-- 页面容器结束 -->
        </controls:NavigationView>
    </Grid>
</Window>
